# API del shell. "auto" (recomendado) = mismo origen (/api/v1): el servidor de
# Vite (dev) o nginx (producción) la reenvía al API Gateway. Funciona igual con
# localhost o con la IP de cualquier red, sin configurar CORS.
# Solo pon una URL completa si de verdad necesitas otro destino.
VITE_API_BASE_URL=auto

# Destino del API Gateway para el proxy /api del servidor de desarrollo.
# Se resuelve en tu máquina, así que localhost sirve aunque abras la app por IP.
VITE_GATEWAY_TARGET=http://localhost:8000

# URL del Gateway que usan los microfrontends ("auto" = http://<host-de-la-página>:8000).
# Si abres la app por IP, agrega ese origen (http://<IP>:3000) a CORS_ORIGINS del API-Gateway.
VITE_GATEWAY_URL=auto
